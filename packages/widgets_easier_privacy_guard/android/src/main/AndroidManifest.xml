<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Install-time permissions that let the app learn about screenshots
       (Android 14+) and screen recording (Android 15+). Neither shows a
       prompt. Remove them with tools:node="remove" if you do not use
       onScreenshot / onScreenRecordingChanged. -->
  <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
  <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
</manifest>
